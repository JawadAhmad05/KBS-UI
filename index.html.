<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Knowledge Base</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
    body { display: flex; height: 100vh; background: #f5f6fa; }

    /* Sidebar */
    .sidebar {
      width: 250px;
      background: #1e1e2f;
      color: white;
      padding: 20px;
    }
    .sidebar h2 { margin-bottom: 20px; }
    .sidebar ul { list-style: none; }
    .sidebar li { padding: 10px 0; cursor: pointer; }
    .sidebar li:hover { color: #00adb5; }

    /* Main */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Search */
    .search-bar {
      padding: 15px;
      background: white;
      border-bottom: 1px solid #ddd;
    }
    .search-bar input {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid #ccc;
    }

    /* Content */
    .content {
      padding: 20px;
      overflow-y: auto;
    }

    .card {
      background: white;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 15px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .card h3 { margin-bottom: 10px; }
  </style>
</head>
<body>

  <div class="sidebar">
    <h2>Docs</h2>
    <ul>
      <li onclick="loadContent('intro')">Introduction</li>
      <li onclick="loadContent('setup')">Setup</li>
      <li onclick="loadContent('api')">API</li>
    </ul>
  </div>

  <div class="main">
    <div class="search-bar">
      <input type="text" id="search" placeholder="Search..." onkeyup="searchContent()" />
    </div>

    <div class="content" id="content">
      <div class="card">
        <h3>Welcome</h3>
        <p>Select a topic from the sidebar.</p>
      </div>
    </div>
  </div>

  <script>
    const data = {
      intro: "This is the introduction section of your knowledge base.",
      setup: "Here you will find setup instructions.",
      api: "API documentation goes here."
    };

    function loadContent(section) {
      const content = document.getElementById('content');
      content.innerHTML = `
        <div class="card">
          <h3>${section.toUpperCase()}</h3>
          <p>${data[section]}</p>
        </div>
      `;
    }

    function searchContent() {
      const query = document.getElementById('search').value.toLowerCase();
      const content = document.getElementById('content');
      let results = '';

      for (let key in data) {
        if (data[key].toLowerCase().includes(query)) {
          results += `
            <div class="card">
              <h3>${key.toUpperCase()}</h3>
              <p>${data[key]}</p>
            </div>
          `;
        }
      }

      content.innerHTML = results || '<div class="card"><p>No results found.</p></div>';
    }
  </script>

</body>
</html>

